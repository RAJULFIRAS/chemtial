{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npx prisma generate && npx tsc",
  "installCommand": "npm install --legacy-peer-deps --include=dev",
  "functions": {
    "api/index.ts": {
      "includeFiles": "prisma/**",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}
