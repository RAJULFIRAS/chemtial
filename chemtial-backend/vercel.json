{
  "version": 2,
  "buildCommand": "prisma generate && tsc",
  "installCommand": "npm install",
  "functions": {
    "api/index.ts": {
      "includeFiles": "prisma/**",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}
